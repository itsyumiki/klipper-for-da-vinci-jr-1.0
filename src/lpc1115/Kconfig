# Kconfig settings for LPC1115 processors (NXP LPC11xx, Cortex-M0)

if MACH_LPC1115

config LPC1115_SELECT
    bool
    default y
    select HAVE_GPIO
    select HAVE_GPIO_ADC
    select HAVE_GPIO_I2C
    select HAVE_GPIO_SPI
    select HAVE_GPIO_HARD_PWM

config BOARD_DIRECTORY
    string
    default "lpc1115"

config MCU
    string
    default "lpc1115"

config CLOCK_FREQ
    int
    default 12000000 # internal RC oscillator, PLL not used yet

config FLASH_SIZE
    hex
    default 0x10000 # 64KiB

config FLASH_BOOT_ADDRESS
    hex
    default 0x0

config FLASH_APPLICATION_ADDRESS
    hex
    default 0x0

config RAM_START
    hex
    default 0x10000000

config RAM_SIZE
    hex
    default 0x1fe0 # (0x2000 - 32) - top 32 bytes reserved for IAP (verify)

config STACK_SIZE
    int
    # The finalize_config call chain alone needs ~540 bytes (run_tasks has a
    # 352 byte frame after LTO inlining).  The stack sits directly above the
    # dynamic move-queue region, which finalize_config memset()s up to
    # _stack_start, so a stack deeper than STACK_SIZE gets zeroed under
    # itself (HardFault with pc=0).  Keep generous headroom.
    default 1024


######################################################################
# Communication inteface
######################################################################

choice
    prompt "Communication interface"
    config LPC1115_SERIAL_UART0_P16_P17
        bool "Serial (on UART PIO1_6/PIO1_7)"
        select SERIAL
endchoice

endif
